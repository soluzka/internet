{
  // Cloudflare Worker that serves public/ and transcribes voice clips.
  // Deploy with: npx wrangler deploy
  "name": "browser",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // No AI binding: this deployment runs no Cloudflare-hosted models. The AI is
  // the local song_service, which the page reaches on this machine.
  // Where the download backend lives. Static hosting cannot run yt-dlp, so the
  // Worker forwards /api/download and /download_file/... to this URL. Leave it
  // empty to keep downloads disabled on the deployed copy; the page then opens
  // the source page instead. Can also be set in the dashboard (Settings ->
  // Variables) without touching this file.
  "vars": {
    "DOWNLOAD_API": ""
  },
  "observability": {
    "enabled": true
  }
}
