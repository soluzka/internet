{
  // Cloudflare Worker that serves public/ and transcribes voice clips.
  // Deploy with: npx wrangler deploy
  "name": "browser",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // One Cloudflare-hosted model, and only for voice: /api/transcribe runs
  // Whisper on the edge so the microphone works without any app running. Music
  // and lyrics stay local - song_service runs those on this machine's GPU.
  // Where the download backend lives. Static hosting cannot run yt-dlp, so the
  // Worker forwards /api/download and /download_file/... to this URL. Leave it
  // empty to keep downloads disabled on the deployed copy; the page then opens
  // the source page instead. Can also be set in the dashboard (Settings ->
  // Variables) without touching this file.
  // Neither service needs a variable any more: the deployed page asks this
  // machine directly (127.0.0.1:5001 for downloads, 127.0.0.1:8090 for the song
  // model), which is what config.js now points at. A tunnel address used to sit
  // here, and it went stale every time the tunnel restarted, leaving the live
  // site calling an address that no longer existed.
  "vars": {
    "DOWNLOAD_API": "",
    // Optional address of the music model when it is reachable from the
    // internet. Empty means the Worker answers /api/song and /api/lyrics with a
    // clear "this runs on the GPU machine" instead of a 405.
    "SONG_API": ""
  },
  "ai": {
    "binding": "AI"
  },
  // The index the site searches. It used to be a 3 MB videos.json that the page
  // downloaded in full before it could show a single result; the same 8,724 rows
  // live here now, so /api/search answers with thirty at a time and the table can
  // be updated without redeploying the page.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-index",
      "database_id": "95b355c9-264c-4ee6-aa11-f4bf6b021a43"
    }
  ],
  "observability": {
    "enabled": true
  }
}
