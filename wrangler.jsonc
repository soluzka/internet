{
  // Cloudflare Worker that serves public/ and transcribes voice clips.
  // Deploy with: npx wrangler deploy
  "name": "browser",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
