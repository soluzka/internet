# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Node
node_modules/

# build/ is tracked, so the scripts in it are on GitHub. Only what the build
# generates stays out, because it cannot be stored in a commit: PyInstaller's
# work folder holds a 314 MB package and the portable Node install holds a
# 103 MB workerd.exe, and GitHub rejects any file over 100 MB.
build/ai_engine/
build/wrangler-tool/

# Leftovers from making the build, not part of it
build/commit_msg*.txt
build/served_*
build/inline.js
build/launcher_trace.txt
build/*.wav
build/*.mp3
build/*.json
build/*.sql

# Wrangler's own cache, written by every deploy
dist/
.wrangler/

# Local runtime data and caches
instance/
cache/
backups/
*.db
*.sqlite3
*.log
*.err
# The backend's video index ships with the repo
!data/video_index.db

# Local model work: the ACE-Step checkout, its weights and its environment
# are gigabytes of third-party material and must never be committed.
third_party/
song_service/.venv/
song_service/models/
song_service/logs/

# Freebuff desktop metadata
.freebuff/

# The tunnel binary is a 55 MB download, not source
tools/bin/*.exe
# Portable Node, used only to run wrangler from this machine
tools/node/

# Environment secrets
.env
.env.*
