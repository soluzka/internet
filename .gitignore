# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Node
node_modules/

# Build output. PyInstaller's work folder, the portable Node and its wrangler
# install, one-off probes, captured logs and test audio all live here and none of
# it is source. Six scripts are the exception because they are how a change gets
# checked after it is made; everything else in the folder stays local.
build/*
!build/deploy_and_check.ps1
!build/verify_live.ps1
!build/asset_check.ps1
!build/service_state.ps1
!build/autostart_status.ps1
!build/race_test.ps1
dist/

# Local runtime data and caches
instance/
cache/
backups/
*.db
*.sqlite3
*.log
*.err
# The backend's video index ships with the repo
!data/video_index.db

# Local model work: the ACE-Step checkout, its weights and its environment
# are gigabytes of third-party material and must never be committed.
third_party/
song_service/.venv/
song_service/models/
song_service/logs/

# Freebuff desktop metadata
.freebuff/

# The tunnel binary is a 55 MB download, not source
tools/bin/*.exe
# Portable Node, used only to run wrangler from this machine
tools/node/

# Environment secrets
.env
.env.*
